{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AnalyzeJobCompletionResult",
  "type": "object",
  "required": [
    "job_id",
    "claims",
    "evidence_candidates"
  ],
  "properties": {
    "job_id": {
      "type": "string"
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim_id",
          "text"
        ],
        "properties": {
          "claim_id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "source_ref": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "evidence_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "evidence_id",
          "type"
        ],
        "properties": {
          "evidence_id": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "label": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}